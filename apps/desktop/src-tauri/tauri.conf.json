{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Canvas",
  "mainBinaryName": "echo-canvas-desktop",
  "identifier": "app.echocanvas.desktop",
  "build": {
    "beforeDevCommand": "pnpm -C apps/desktop/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C apps/desktop/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Echo Canvas",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true,
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
